+++ b/tests/plugins/test_symphony_pm_codex_exec_probe.py
@@ -0,0 +1,64 @@
+"""Fixture coverage for sandbox verdicts and attempt cleanup."""
+import pytest
+
+from plugins.symphony_pm.transport.codex_exec_launcher import clean_artifacts, probe_ok
+
+
+OUTSIDE_STEPS = ('read-auth', 'list-codex-home', 'read-outside', 'write-outside', 'loopback')
+
+
+@pytest.fixture
+def probe_report():
+    return {'steps': [
+        {'name': 'env', 'ok': True, 'secret_like_names': [], 'suspicious_values': []},
+        *({'name': name, 'ok': False} for name in OUTSIDE_STEPS),
+    ]}
+
+
+def test_probe_accepts_clean_denied_report(probe_report):
+    assert probe_ok(probe_report) is True
+
+
+@pytest.mark.parametrize('name', OUTSIDE_STEPS)
+@pytest.mark.parametrize('missing', [False, True], ids=['allowed', 'missing'])
+def test_probe_requires_each_outside_step_to_be_denied(probe_report, name, missing):
+    steps = probe_report['steps']
+    step = next(step for step in steps if step['name'] == name)
+    if missing:
+        steps.remove(step)
+    else:
+        step['ok'] = True
+    assert probe_ok(probe_report) is False
+
+
+@pytest.mark.parametrize('env_fields', [
+    {'ok': False},
+    {'secret_like_names': ['EXAMPLE_API_KEY']},
+    {'suspicious_values': ['EXAMPLE_SETTING']},
+])
+def test_probe_requires_clean_successful_env(probe_report, env_fields):
+    probe_report['steps'][0].update(env_fields)
+    assert probe_ok(probe_report) is False
+
+
+def test_clean_artifacts_removes_only_generated_directories(tmp_path):
+    caches = (
+        'package/__pycache__',
+        '.pytest_cache',
+        'package/.ruff_cache',
+        'Microsoft/Windows/PowerShell',
+    )
+    for cache in caches:
+        path = tmp_path / cache
+        path.mkdir(parents=True)
+        (path / 'generated').write_text('cache', encoding='utf-8')
+
+    kept = (tmp_path / 'package' / 'source.py', tmp_path / '.ruff_cache')
+    for path in kept:
+        path.write_text('keep', encoding='utf-8')
+
+    assert sorted(clean_artifacts(tmp_path)) == sorted(caches)
+    assert all(not (tmp_path / cache).exists() for cache in caches)
+    assert not (tmp_path / 'Microsoft' / 'Windows').exists()
+    assert not (tmp_path / 'Microsoft').exists()
+    assert all(path.read_text(encoding='utf-8') == 'keep' for path in kept)
